# fitai-api configuration. Copy to `backend/.env` for local dev.
# Real .env is gitignored.

# Postgres connection string. Matches `backend/docker-compose.yml`.
DATABASE_URL=postgres://fitai:dev@localhost:5432/fitai

# JWT signing secret for HS256. ANY non-empty string works for local dev.
# In production this comes from a secret manager (R-0026).
JWT_SECRET=dev-only-secret-replace-in-production

# Optional: HTTP listen port (default 8080).
# PORT=8080

# Optional: tracing filter. Defaults to "info".
# RUST_LOG=fitai_api=debug,info

# --- Voice-intent LLM (R-0032) -------------------------------------------
# The voice parser uses an LLM to turn a transcript into a structured log,
# falling back to the built-in keyword parser when no LLM is configured.
#
# Default provider is Anthropic; set ANTHROPIC_API_KEY (or LLM_API_KEY) to
# enable it. With no key, the keyword parser is used.
# ANTHROPIC_API_KEY=sk-ant-...
#
# To test locally against Ollama (or any OpenAI-compatible server) instead,
# set LLM_PROVIDER and — if you want non-defaults — the base URL / model.
# No key is needed for a local Ollama.
#   ollama pull llama3.2   # once
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1   # default when provider=ollama
# LLM_MODEL=llama3.2                        # default when provider=ollama
# LLM_API_KEY=                              # blank for local Ollama

# Optional: USDA FoodData Central key for nutrient lookup.
# FDC_API_KEY=

# --- Password-reset email (R-0060) ----------------------------------------
# Cloudflare Email Service over REST. With the first three unset the API runs
# with reset email disabled and logs a warning at boot; the forgot endpoint
# still answers 202. In production these come from the Worker (infra/cloudflare).
# CF_ACCOUNT_ID=
# CF_EMAIL_API_TOKEN=
# PUBLIC_WEB_URL=http://localhost:9500
# MAIL_FROM=no-reply@goosethropic.systems
# MAIL_FROM_NAME="Goose Fitness Physics"
